    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Course.Invoice.Math</PackageId>
    <Version>1.2.0</Version>
    <Authors>Luis Coco Enríquez</Authors>
