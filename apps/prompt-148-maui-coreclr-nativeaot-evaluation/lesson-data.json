{
  "number": 148,
  "title": "CoreCLR and Native AOT evaluation",
  "files": [
    "App/App.csproj",
    "App/Program.cs",
    "lab-runtime.cjs",
    "NuGet.Config",
    "Native/Platforms/Windows/App.xaml",
    "Native/Platforms/Windows/App.xaml.cs",
    "Native/Platforms/Windows/app.manifest",
    "Native/Platforms/Windows/Package.appxmanifest",
    "Native/Native.csproj",
    "Native/MauiProgram.cs",
    "Native/App.cs",
    "Native/LessonChecks.cs",
    "Native/NativeCapture.cs",
    "Native/GlobalUsings.cs",
    "Native/MainPage.cs",
    "Native/NativeReport.cs",
    "App/Probe.cs",
    "EXERCISE.txt"
  ],
  "resetFiles": {
    "App/Probe.cs": "// The lesson inserts a controlled compiler experiment here.\n"
  },
  "steps": [
    {
      "id": "build",
      "label": "Build and verify the native app",
      "commands": [
        [
          "build",
          "Native",
          "-c",
          "Release"
        ],
        [
          "build",
          "App",
          "-c",
          "Release"
        ],
        [
          "run",
          "--project",
          "App",
          "-c",
          "Release",
          "--no-build",
          "--",
          "verify"
        ]
      ],
      "contains": [
        "PASS",
        "native:"
      ]
    },
    {
      "id": "problem",
      "label": "Reproduce the incorrect assumption",
      "commands": [
        [
          "run",
          "--project",
          "App",
          "-c",
          "Release",
          "--no-build",
          "--",
          "problem"
        ]
      ],
      "failure": true,
      "contains": [
        "incorrect expectation: the CoreCLR build is already Native AOT"
      ]
    },
    {
      "id": "aot",
      "label": "Publish and run Native AOT",
      "commands": [
        [
          "publish",
          "Native",
          "-c",
          "Release",
          "-r",
          "win-x64",
          "-p:PublishAot=true",
          "-p:PublishReadyToRun=false",
          "-o",
          "artifacts/nativeaot",
          "-p:TrimmerSingleWarn=false"
        ],
        [
          "run",
          "--project",
          "App",
          "-c",
          "Release",
          "--no-build",
          "--",
          "aot"
        ]
      ],
      "contains": [
        "PASS",
        "native:"
      ]
    },
    {
      "id": "repair",
      "label": "Verify the supported native behavior",
      "commands": [
        [
          "build",
          "Native",
          "-c",
          "Release"
        ],
        [
          "run",
          "--project",
          "App",
          "-c",
          "Release",
          "--no-build",
          "--",
          "verify"
        ]
      ],
      "contains": [
        "PASS",
        "native:"
      ]
    }
  ]
}