@page "/Join"
@model JoinModel
<!doctype html><html><head><title>Razor Pages enrollment</title><style>body{margin:0;background:#f4f0fb;color:#21133f;font:28px/1.4 Segoe UI,Arial}main{max-width:1000px;margin:45px auto;background:white;border:2px solid #c8b6e8;border-radius:24px;padding:38px}small{color:#7042a8;font-weight:700}h1{font-size:46px;line-height:1.15}label{display:block;margin-top:18px;font-weight:600}input{display:block;font:inherit;width:90%;padding:12px;border:2px solid #aaa;border-radius:8px}button{font:inherit;background:#6134a7;color:white;border:0;border-radius:10px;padding:15px 28px;margin-top:28px}.field-validation-error{display:block;color:#b31936;font-weight:600}a{color:#6134a7}.success{background:#e5f7ec;border-left:8px solid #13a56c;padding:24px}</style></head><body><main>
<small>.NET 11 • RAZOR PAGES</small><h1>Join the workshop</h1><p>This form targets the page model's Reserve handler.</p>
<form method="post" asp-page-handler="Reserve">
<label asp-for="Input.Name"></label><input asp-for="Input.Name" id="Name" /><span asp-validation-for="Input.Name"></span>
<label asp-for="Input.Seats"></label><input asp-for="Input.Seats" id="Seats" /><span asp-validation-for="Input.Seats"></span>
<button type="submit">Reserve seats</button></form></main></body></html>
