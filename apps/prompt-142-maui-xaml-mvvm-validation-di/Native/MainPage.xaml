<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NativeCourse" x:DataType="local:CourseViewModel" x:Class="NativeCourse.MainPage" BackgroundColor="#F4F2FB" Title="MVVM course editor">
    <VerticalStackLayout Padding="36" Spacing="18">
        <Label Text=".NET 11 · MAUI MVVM" FontSize="18" TextColor="#6642BB" />
        <Label Text="Edit a course" FontSize="30" FontAttributes="Bold" />
        <Label Text="Course title" FontSize="20" />
        <Entry x:Name="TitleEntry" Text="{Binding Title, Mode=TwoWay}" Placeholder="At least three characters" FontSize="20" />
        <Label Text="{Binding ErrorsText}" TextColor="#9E2539" FontSize="18" />
        <Button x:Name="SaveButton" Text="Save course" Command="{Binding SaveCommand}" HorizontalOptions="Start" />
        <Border Padding="24" BackgroundColor="#E1F7EE"><Label x:Name="StatusLabel" Text="{Binding Status}" FontSize="22" /></Border>
    </VerticalStackLayout>
</ContentPage>
