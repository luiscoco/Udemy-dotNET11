@page "/"
@inject IHttpClientFactory Clients
@inject NavigationManager Navigation
<main><header><p>RUNNABLE .NET 11 • PROMPT 194 • REAL LOCAL INFERENCE</p><h1>Stream a model response into Blazor</h1></header>
<section><h2>Ask: Explain dependency injection in three sentences.</h2>
<button id="ask" disabled="@(!ready || busy)" @onclick="Ask">Run live model request</button>
<p class="status" id="status">@status</p><p class="status">Visible model updates: <strong id="updates">@updates</strong></p></section>
<section><h2>Actual model response</h2><div id="answer">@answer</div></section></main>
@code {
    bool ready, busy;
    int updates;
    string answer = "", status = "Connecting Blazor circuit";
    protected override void OnAfterRender(bool first)
    {
        if (first) { ready = true; status = "Ready"; StateHasChanged(); }
    }
    async Task Ask()
    {
        busy = true; updates = 0; answer = ""; status = "Streaming";
        using var http = Clients.CreateClient();
        using var response = await http.GetAsync(new Uri(new Uri(Navigation.BaseUri), "api/chat"), HttpCompletionOption.ResponseHeadersRead);
        response.EnsureSuccessStatusCode();
        using var stream = await response.Content.ReadAsStreamAsync();
        using var reader = new StreamReader(stream);
        while (await reader.ReadLineAsync() is { } line)
        {
            using var json = JsonDocument.Parse(line);
            answer += json.RootElement.GetProperty("text").GetString();
            updates++;
            await InvokeAsync(StateHasChanged);
        }
        busy = false; status = "Complete";
    }
}
