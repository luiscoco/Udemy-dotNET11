<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NativeCourse.MainPage" BackgroundColor="#F4F2FB" Title="Interrupted work">
    <VerticalStackLayout Padding="36" Spacing="18">
        <Label Text=".NET 11 · Application lifecycle" FontSize="18" TextColor="#6642BB" />
        <Label Text="Keep a draft through interruption" FontSize="30" FontAttributes="Bold" />
        <Label Text="Draft title" FontSize="20" />
        <Entry x:Name="DraftEntry" Text="My offline course draft" FontSize="20" />
        <HorizontalStackLayout Spacing="16">
            <Button Text="Begin operation" Clicked="Begin" />
            <Button Text="Pause operation" Clicked="Pause" />
            <Button Text="Resume" Clicked="Resume" />
        </HorizontalStackLayout>
        <Border Padding="24" BackgroundColor="#E1F7EE"><Label x:Name="StateLabel" Text="Ready" FontSize="22" /></Border>
        <Label Text="Window backgrounding and connectivity loss use the same cancellation path." FontSize="18" />
    </VerticalStackLayout>
</ContentPage>
