FROM mcr.microsoft.com/mssql/server@sha256:05644dad1266ca3d445d1e8f6d2ebb9a6a03df9a39376e0f7b48917356dca9d9
USER root
ADD https://packages.microsoft.com/config/ubuntu/24.04/mssql-server-2025.list /etc/apt/sources.list.d/mssql-server-2025.list
RUN apt-get update && ACCEPT_EULA=Y apt-get install -y mssql-server=17.0.5065.9-3 mssql-server-fts=17.0.5065.9-3 && rm -rf /var/lib/apt/lists/*
USER mssql
